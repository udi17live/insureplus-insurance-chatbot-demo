{
  "openapi": "3.1.0",
  "info": { "title": "Create Insurance Quote", "version": "1.0.0" },
  "servers": [{ "url": "https://insure-plus-backend.victoriousplant-141de2b1.centralus.azurecontainerapps.io/api/v1" }],
  "paths": {
    "/agent/quotes": {
      "post": {
        "description": "Persists an insurance quote with the premium amount calculated from RAG pricing data. User identity is resolved server-side from session_id.",
        "operationId": "agent_create_quote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["session_id", "product_type", "collected_fields", "premium_amount", "coverage_summary"],
                "properties": {
                  "session_id": { "type": "string", "format": "uuid" },
                  "product_type": { "type": "string", "enum": ["motor", "bike", "life", "device"] },
                  "collected_fields": { "type": "object" },
                  "premium_amount": { "type": "number" },
                  "currency": { "type": "string", "default": "GBP" },
                  "coverage_summary": { "type": "object" },
                  "expires_at": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created quote",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quote_id": { "type": "string" },
                    "product_type": { "type": "string" },
                    "premium_amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "coverage_summary": { "type": "object" },
                    "expires_at": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "security": [{ "apiKeyHeader": [] }]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    }
  },
  "security": [{ "apiKeyHeader": [] }]
}
