{
  "openapi": "3.1.0",
  "info": { "title": "Confirm Quote Payment", "version": "1.0.0" },
  "servers": [{ "url": "https://rs70p1pc-8000.asse.devtunnels.ms/api/v1" }],
  "paths": {
    "/agent/quotes/{quote_id}/confirm": {
      "post": {
        "description": "Simulates payment and creates an active policy from the quote. Call only when the user explicitly agrees to purchase. User identity is resolved server-side from session_id.",
        "operationId": "agent_confirm_payment",
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Active policy created from the confirmed quote",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "policy_id": { "type": "string" },
                    "policy_number": { "type": "string" },
                    "product_type": { "type": "string" },
                    "status": { "type": "string" },
                    "premium_amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "coverage_data": { "type": "object" },
                    "start_date": { "type": "string" },
                    "end_date": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "security": [{ "apiKeyHeader": [] }]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    }
  },
  "security": [{ "apiKeyHeader": [] }]
}
