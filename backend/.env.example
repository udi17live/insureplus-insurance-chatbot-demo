APP_NAME="Insure Plus API"
APP_VERSION="0.1.0"
DEBUG=false
ALLOWED_ORIGINS='["http://localhost:3000"]'

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/insure_plus

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Azure AI Foundry
AZURE_AI_PROJECT_BASE_ENDPOINT=
PRIMARY_AGENT_ID=
PRIMARY_AGENT_MODEL=gpt-5.4-mini

# Azure Identity (Service Principal for local/Docker; use Managed Identity in Azure)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Azure Communication Services (optional)
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# Agent token limits
AGENT_MAX_PROMPT_TOKENS=4000
AGENT_MAX_COMPLETION_TOKENS=600
