{
  "openapi": "3.1.0",
  "info": { "title": "List User Policies", "version": "1.0.0" },
  "servers": [{ "url": "https://rs70p1pc-8000.asse.devtunnels.ms/api/v1" }],
  "paths": {
    "/agent/policies": {
      "get": {
        "description": "Returns all insurance policies for the user associated with the given session_id.",
        "operationId": "agent_list_policies",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of policies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "policy_id": { "type": "string" },
                      "policy_number": { "type": "string" },
                      "product_type": { "type": "string" },
                      "status": { "type": "string" },
                      "premium_amount": { "type": "number" },
                      "currency": { "type": "string" },
                      "coverage_data": { "type": "object" },
                      "start_date": { "type": "string" },
                      "end_date": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [{ "apiKeyHeader": [] }]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    }
  },
  "security": [{ "apiKeyHeader": [] }]
}
