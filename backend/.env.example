APP_NAME="Insure Plus API"
APP_VERSION="0.1.0"
DEBUG=false
ALLOWED_ORIGINS_RAW=http://localhost:3000

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/insure_plus

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Azure AI Foundry
AZURE_AI_PROJECT_BASE_ENDPOINT=
PRIMARY_AGENT_ID=

# Azure Identity (Service Principal for local/Docker; use Managed Identity in Azure)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Redis (used for rate limiting)
REDIS_URL=redis://localhost:6379

# Agent response limit
AGENT_MAX_COMPLETION_TOKENS=600

# Agent tool API key (Foundry uses this to authenticate calls to our tool endpoints)
AGENT_API_KEY=generate-a-secure-random-key
